            preview.style.display = 'block';
        };

        if (file) {
            reader.readAsDataURL(file);
        } else {
            preview.src = "";
        }
    }
    function previewSKS() {
        var preview = document.getElementById('skdStampPreview');
        var file = document.getElementById('skdStamp').files[0];
        var reader = new FileReader();

        reader.onloadend = function () {
            preview.src = reader.result;
            preview.style.display = 'block';
        };

        if (file) {
            reader.readAsDataURL(file);
        } else {
            preview.src = "";
        }
    }

    function prevStudentSignature() {
        var preview = document.getElementById('studentSignaturePreview');
        var file = document.getElementById('studentSignature').files[0];
        var reader = new FileReader();

        reader.onloadend = function () {
            preview.src = reader.result;
            preview.style.display = 'block';
        };

        if (file) {
            reader.readAsDataURL(file);
        } else {
            preview.src = "";
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Tüm input elemanlarını seç
        var inputs = document.querySelectorAll('input[name]:not([type="radio"]):not([type="checkbox"]), textarea[name], select[name]');

        // sadece görünür olanları al
        inputs = Array.from(inputs).filter(input => input.offsetParent !== null);

        // input elemanlarını name attribute'una göre grupla
        const inputGroups = {};
        inputs.forEach(input => {
            const name = input.getAttribute('name');
            if (!inputGroups[name]) {
                inputGroups[name] = [];
            }
            inputGroups[name].push(input);
        });

        // Her grup için event listener ekle
        Object.keys(inputGroups).forEach(name => {
            const group = inputGroups[name];
            group.forEach(input => {
                input.addEventListener('input', (e) => {
                    const newValue = e.target.value;
                    group.forEach(el => {
                        if (el !== e.target) {
                            el.value = newValue;
                        }
                    });
                });
            });
        });


        document.querySelectorAll(".image-preview img").forEach(img => {
            if (!img.src) {
                img.style.display = 'none';
            }

            // js yuklenmeden once img yuklenmis mi kontrol et
            if (img.complete) {
                img.style.display = 'block';
            }

            // js yuklenmeden once img hatasi olmus mu kontrol et
            if (img.naturalWidth === 0) {
                img.style.display = 'none';
            }

            img.onload = function () {
                img.style.display = 'block';
            };

            img.onerror = function () {
                img.style.display = 'none';
            };
        });
    });

    document.addEventListener('DOMContentLoaded', () => {
        // Sayfa yüklendiğinde çalışacak kodlar buraya
        // Belirli bir başlık öncesinde sayfa bölünmesini sağlamak için CSS kullanımı
        const headings = document.querySelectorAll('h1, h2, h3, h4, h5, h6, div');
        headings.forEach(heading => {
            // Sadece belirli başlık öncesinde sayfa bölünmesi
            if (heading.id === 'a') {
                heading.style.pageBreakBefore = 'always';
            }

        });

        const allDivs = document.querySelectorAll('div');
        allDivs.forEach(div => {

            div.classList.add('sr');
        });
    });


</script>